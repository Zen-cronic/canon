# canon — environment
#
# Copy to .env and fill in. NOTHING here is needed for `npm run demo`, which
# runs end to end on committed fixtures with zero credentials.

# DataHub GMS endpoint. Local quickstart default is http://localhost:8080.
# Start one with: datahub docker quickstart   (needs 2 CPU / 8GB RAM)
DATAHUB_GMS_URL=http://localhost:8080

# DataHub personal access token.
# Get it from the DataHub UI at localhost:9002 → Settings → Access Tokens →
# Generate new token. Never commit the real value.
DATAHUB_GMS_TOKEN=

# Anthropic API key for canon's narration path.
# Get it from https://console.anthropic.com → API Keys.
# Optional. The ruling is COMPUTED by the rule table (src/agent/rules.ts) with or
# without a key — no adjudication is ever replayed, and there are no answer
# fixtures in this repo. Without a key the prose is generated deterministically
# from that same table and labelled source: "template".
ANTHROPIC_API_KEY=

# REQUIRED whenever you talk to the MCP server. The telemetry ping is
# synchronous and on the request path, so every tool call blocks ~54s without
# this. Confirmed open bug: acryldata/mcp-server-datahub issue #152.
DATAHUB_TELEMETRY_ENABLED=false

# Unlocks the MCP mutation tools (add_tags, add_terms, update_description,
# add_structured_properties, save_document). Default is false, so write-back
# silently has no tools to call until you set this.
TOOLS_IS_MUTATION_ENABLED=true

# canon's own switches.
#   CANON_MODE=live    use the real DataHub client instead of fixtures
#   CANON_LLM=off      skip the model even when a key is present; prose becomes
#                      deterministic. The ruling is identical either way.
#   CANON_MODEL        override the model id (default claude-opus-5)
#   CANON_FIXTURE      point at a different fixture catalog
CANON_MODE=mock
